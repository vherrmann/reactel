(ert-deftest reactel-text-properties-are-part-of-values ()
  "Strings differing only in text properties are different values."
  (let ((plain "x") (bold (propertize "x" 'face 'bold)))
    (should (reactel--same-value "x" (copy-sequence "x")))
    (should-not (reactel--same-value plain bold))
    (should-not (reactel-props-equal (list :v plain) (list :v bold)))
    (should-not (reactel--same-deps-p (list plain) (list bold)))
    ;; `:memo' re-renders when only the properties change.
    (let ((renders 0))
      (defun reactel-test-props-fn (&rest props) (cl-incf renders) (reactel-c-text (plist-get props :v)))
      (let ((m (reactel-memo 'reactel-test-props-fn)))
        (with-root r (reactel-el m :v plain)
          (reactel-root-render r (reactel-el m :v (copy-sequence plain)))
          (should (= renders 1))
          (reactel-root-render r (reactel-el m :v bold))
          (should (= renders 2)))))
    ;; Effect and memo deps, and the state bail-out.
    (let ((renders 0) (effects 0) (computes 0) setter)
      (reactel-defcomponent reactel-test-props-state ()
        :compile nil
        (cl-destructuring-bind (s set-s) (reactel-use-state plain)
          (setq setter set-s)
          (cl-incf renders)
          (reactel-use-effect (lambda () (cl-incf effects) nil) (list s))
          (reactel-c-text (reactel-use-memo (lambda () (cl-incf computes) s) (list s)))))
      (with-root r (reactel-el 'reactel-test-props-state)
        (reactel-act (funcall setter (copy-sequence plain)))
        (should (equal (list renders effects computes) '(1 1 1)))
        (reactel-act (funcall setter bold))
        (should (equal (list renders effects computes) '(2 2 2)))))))

