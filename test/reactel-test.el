(ert-deftest reactel-setter-identity-stable-and-eager-bailout ()
  (let (setters (renders 0))
    (reactel-defcomponent reactel-test-s ()
      (cl-incf renders)
      (cl-destructuring-bind (n set-n) (reactel-use-state 1)
        (push set-n setters)
        (reactel-c-text (number-to-string n))))
    (with-root r (reactel-el 'reactel-test-s)
      (funcall (car setters) 2)
      (reactel-flush)
      (should (= renders 2))
      (should (eq (car setters) (cadr setters)))
      (funcall (car setters) 2)          ; same value: no re-render
      (reactel-flush)
      (should (= renders 2)))))

(ert-deftest reactel-symbol-state-is-never-called-as-function ()
  ;; `car' and `reactel-el' are fboundp, but as state they are plain data.
  (let (setter)
    (reactel-defcomponent reactel-test-sym ()
      (cl-destructuring-bind (v set-v) (reactel-use-state 'car)
        (setq setter set-v)
        (reactel-c-text (symbol-name v))))
    (with-root r (reactel-el 'reactel-test-sym)
      (should (equal (txt r) "car"))
      (funcall setter 'reactel-el) (reactel-flush)
      (should (equal (txt r) "reactel-el"))
      (funcall setter reactel-toggle)  ; function objects are still updaters
      (reactel-flush)
      (should (equal (txt r) "nil")))))

