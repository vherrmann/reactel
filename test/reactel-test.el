;;; Memo, callback, ref, id

(ert-deftest reactel-use-memo-and-callback ()
  (let (cbs (computes 0) setter)
    (reactel-defcomponent reactel-test-m (&key dep)
      (cl-destructuring-bind (n set-n) (reactel-use-state 0)
        (setq setter set-n)
        (let ((v (reactel-use-memo (lambda () (cl-incf computes) (* 2 dep)) (list dep))))
          (push (reactel-use-callback (lambda () n) (list dep)) cbs)
          (reactel-c-text (format "%d/%d" v n)))))
    (with-root r (reactel-el 'reactel-test-m :dep 4)
      (funcall setter 1) (reactel-flush)
      (should (= computes 1))
      (should (eq (car cbs) (cadr cbs)))
      (should (equal (txt r) "8/1"))
      (reactel-root-render r (reactel-el 'reactel-test-m :dep 5))
      (should (= computes 2))
      (should-not (eq (car cbs) (cadr cbs))))))

