;;; reactel-test.el --- Tests for Reactel -*- lexical-binding: t -*-

(require 'ert)
(require 'reactel)
(require 'reactel-buffer)

(defvar test-log nil)
(defun test-log (&rest xs) (push xs test-log))
(defun test-log-get () (reverse test-log))

(defmacro with-root (var element &rest body)
  "Render ELEMENT into a string root VAR, run BODY, then unmount."
  (declare (indent 2))
  `(let* ((test-log nil)
          (,var (reactel-create-string-root)))
     (unwind-protect
         (progn (reactel-root-render ,var ,element) ,@body)
       (reactel-unmount ,var))))

(defun txt (root) (string-trim (reactel-root-text root)))

;;; Components used below

(reactel-defcomponent reactel-test-counter (&key (initial 0) label)
  (cl-destructuring-bind (n set-n) (reactel-use-state initial)
    (reactel-c-text
      (reactel-c-text (format "%s%d" (or label "") n))
      (reactel-c-button :on-click (lambda () (funcall set-n reactel-inc)) "inc")
      (reactel-c-button :on-click (lambda () (funcall set-n 100)) "set"))))

(ert-deftest reactel-static-render ()
  (reactel-defcomponent reactel-test-hello (&key name children)
    (reactel-c-text "Hello, " name "!" children))
  (should (equal (string-trim
                  (substring-no-properties
                   (reactel-render-to-string
                    (reactel-el 'reactel-test-hello :name "World" (reactel-c-text " ok")))))
                 "Hello, World! ok")))

(ert-deftest reactel-state-updates ()
  (with-root r (reactel-el 'reactel-test-counter :initial 5 :label "n=")
    (should (string-match-p "n=5" (txt r)))
    (reactel-click r "inc")
    (should (string-match-p "n=6" (txt r)))
    (reactel-click r "set")
    (should (string-match-p "n=100" (txt r)))))

(ert-deftest reactel-batched-updates-render-once ()
  (let ((renders 0) setter)
    (reactel-defcomponent reactel-test-b ()
      (cl-incf renders)
      (cl-destructuring-bind (n set-n) (reactel-use-state 0)
        (setq setter set-n)
        (reactel-c-text (number-to-string n))))
    (with-root r (reactel-el 'reactel-test-b)
      (should (= renders 1))
      (reactel-batch
	(funcall setter reactel-inc) (funcall setter reactel-inc) (funcall setter reactel-inc))
      (should (= renders 2))
      (should (equal (txt r) "3")))))

