;;; Effects

(ert-deftest reactel-effect-deps-and-cleanup-order ()
  (reactel-defcomponent reactel-test-eff (&key a b)
    (reactel-use-effect (lambda () (test-log 'run-a a) (lambda () (test-log 'clean-a a)))
                        (list a))
    (reactel-use-effect (lambda () (test-log 'run-once) (lambda () (test-log 'clean-once))) nil)
    (reactel-use-effect (lambda () (test-log 'run-always b) nil) :always)
    (reactel-c-text "e"))
  (with-root r (reactel-el 'reactel-test-eff :a 1 :b 1)
    (should (equal (test-log-get) '((run-a 1) (run-once) (run-always 1))))
    (setq test-log nil)
    (reactel-root-render r (reactel-el 'reactel-test-eff :a 1 :b 2)) ; a unchanged
    (should (equal (test-log-get) '((run-always 2))))
    (setq test-log nil)
    (reactel-root-render r (reactel-el 'reactel-test-eff :a 2 :b 2))
    (should (equal (test-log-get) '((clean-a 1) (run-a 2) (run-always 2))))
    (setq test-log nil)
    (reactel-root-render r nil)         ; unmount
    (should (equal (test-log-get) '((clean-a 2) (clean-once))))))

