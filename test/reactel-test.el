;;; Reconciliation

(ert-deftest reactel-state-preserved-by-position-and-reset-on-type-change ()
  (reactel-defcomponent reactel-test-other () (cl-destructuring-bind (n _) (reactel-use-state 0)
						(reactel-c-text (format "o%d" n))))
  (with-root r (reactel-c-text (reactel-el 'reactel-test-counter :initial 0 :label "n="))
    (reactel-click r "inc")
    (reactel-root-render r (reactel-c-text (reactel-el 'reactel-test-counter :initial 0 :label "n=")))
    (should (string-match-p "n=1" (txt r)))             ; preserved
    (reactel-root-render r (reactel-c-text (reactel-el 'reactel-test-other)))
    (should (string-match-p "o0" (txt r)))
    (reactel-root-render r (reactel-c-text (reactel-el 'reactel-test-counter :initial 0 :label "n=")))
    (should (string-match-p "n=0" (txt r)))))           ; fresh state

(ert-deftest reactel-keys-preserve-state-across-reorder ()
  (reactel-defcomponent reactel-test-item (&key name)
    (reactel-use-effect (lambda () (test-log 'mount name) (lambda () (test-log 'unmount name))) nil)
    (cl-destructuring-bind (n set-n) (reactel-use-state 0)
      (reactel-c-text (reactel-c-text (format "%s:%d " name n))
        (reactel-c-button :on-click (lambda () (funcall set-n reactel-inc)) (format "+%s" name)))))
  (cl-flet ((list-of (names)
              (reactel-c-text (mapcar (lambda (n) (reactel-el 'reactel-test-item :key n :name n)) names))))
    (with-root r (list-of '("a" "b" "c"))
      (reactel-click r "+b")
      (setq test-log nil)
      (reactel-root-render r (list-of '("c" "b" "a")))
      (should (string-match-p "c:0 .*b:1 .*a:0" (replace-regexp-in-string "\n" " " (txt r))))
      (should (null test-log))                     ; nothing remounted
      (reactel-root-render r (list-of '("c" "a")))
      (should (equal (test-log-get) '((unmount "b")))))))

