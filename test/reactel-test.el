;;; Error boundaries

(reactel-defcomponent reactel-test-boom () (error "kaboom"))

(ert-deftest reactel-error-boundary-catches-and-resets ()
  (let (reset-fn caught)
    (reactel-defcomponent reactel-test-ok-kid ()
      (reactel-use-effect (lambda () (lambda () (test-log 'ok-kid-unmounted))) nil)
      (reactel-c-text "fine"))
    (cl-flet ((tree (&rest kids)
                (apply #'reactel-c-error-boundary
                       :fallback (lambda (err reset) (setq reset-fn reset)
                                   (reactel-c-text (format "failed: %s" (cadr err))))
                       :on-error (lambda (e) (setq caught e))
                       kids)))
      (with-root r (tree (reactel-el 'reactel-test-ok-kid))
	(should (equal (txt r) "fine"))
	(reactel-root-render r (tree (reactel-el 'reactel-test-ok-kid) (reactel-el 'reactel-test-boom)))
	(should (equal (txt r) "failed: kaboom"))
	(should caught)
	(should (equal (test-log-get) '((ok-kid-unmounted))))
	;; Reset retries the (still failing) children.
	(reactel-act (funcall reset-fn))
	(should (equal (txt r) "failed: kaboom"))))))

(ert-deftest reactel-error-boundary-reset-keys ()
  (with-root r (reactel-c-error-boundary :fallback (reactel-c-text "bad") :reset-keys '(1)
                 (reactel-el 'reactel-test-boom))
    (should (equal (txt r) "bad"))
    (reactel-root-render r (reactel-c-error-boundary :fallback (reactel-c-text "bad") :reset-keys '(2)
                             (reactel-c-text "good")))
    (should (equal (txt r) "good"))))

(ert-deftest reactel-uncaught-error-unmounts-tree ()
  (reactel-defcomponent reactel-test-cleanup-kid ()
    (reactel-use-effect (lambda () (lambda () (test-log 'cleaned))) nil)
    (reactel-c-text "k"))
  (let* ((test-log nil) (r (reactel-create-string-root)))
    (reactel-root-render r (reactel-c-text (reactel-el 'reactel-test-cleanup-kid)))
    (should-error (reactel-root-render r (reactel-c-text (reactel-el 'reactel-test-cleanup-kid) (reactel-el 'reactel-test-boom))))
    (should (equal (test-log-get) '((cleaned))))))

;;; External store, timers

(ert-deftest reactel-sync-external-store ()
  (let* ((store 1) (subs nil))
    (reactel-defcomponent reactel-test-ext ()
      (reactel-c-text (number-to-string
                       (reactel-use-sync-external-store
			(lambda (cb) (push cb subs) (lambda () (setq subs (delq cb subs))))
			(lambda () store)))))
    (with-root r (reactel-el 'reactel-test-ext)
      (should (equal (txt r) "1"))
      (setq store 2)
      (reactel-act (mapc #'funcall subs))
      (should (equal (txt r) "2")))
    (should (null subs))))

(ert-deftest reactel-async-updates-are-coalesced-by-timer ()
  (let (setter (renders 0))
    (reactel-defcomponent reactel-test-t1 ()
      (cl-incf renders)
      (cl-destructuring-bind (n set-n) (reactel-use-state 0)
        (setq setter set-n) (reactel-c-text (number-to-string n))))
    (with-root r (reactel-el 'reactel-test-t1)
      (funcall setter reactel-inc) (funcall setter reactel-inc)
      (should (= renders 1))                         ; not yet
      (should (equal (txt r) "0"))
      (sleep-for 0.05)
      (should (= renders 2))
      (should (equal (txt r) "2")))))

;;; Buffer renderer

(ert-deftest reactel-buffer-render-click-and-kill ()
  (let ((buf "*reactel-test*") root)
    (unwind-protect
        (progn
          (reactel-defcomponent reactel-test-bc ()
            (reactel-use-effect (lambda () (lambda () (test-log 'killed))) nil)
            (cl-destructuring-bind (n set-n) (reactel-use-state 0)
              (reactel-c-text (reactel-c-text (format "count=%d " n))
                (reactel-c-button :on-click (lambda () (funcall set-n reactel-inc)) "add"))))
          (setq test-log nil)
          (setq root (reactel-render-buffer buf (reactel-el 'reactel-test-bc)))
          (with-current-buffer buf
            (should (string-match-p "count=0 \\[add\\]" (buffer-string)))
            (goto-char (point-min))
            (search-forward "add")
            (push-button)
            (should (string-match-p "count=1" (buffer-string)))
            (goto-char (point-min))
            (forward-button 1)
            (should (looking-at "\\[add"))))
      (kill-buffer buf))
    (should (equal (test-log-get) '((killed))))))

;;; Hook macros

(ert-deftest reactel-macro-effect-deps-forms ()
  (reactel-defcomponent reactel-test-mac-eff (&key a b)
    (reactel-use-effect* (a) (test-log 'dep-a a) nil)
    (reactel-use-effect* () (test-log 'once) (lambda () (test-log 'once-cleanup)))
    (reactel-use-effect* :always (test-log 'always b) nil)
    (reactel-use-layout-effect* (b) (test-log 'layout b) nil)
    (reactel-c-text "m"))
  (with-root r (reactel-el 'reactel-test-mac-eff :a 1 :b 1)
    (should (equal (test-log-get) '((layout 1) (dep-a 1) (once) (always 1))))
    (setq test-log nil)
    (reactel-root-render r (reactel-el 'reactel-test-mac-eff :a 1 :b 2))
    (should (equal (test-log-get) '((layout 2) (always 2))))
    (setq test-log nil)
    (reactel-root-render r nil)
    (should (equal (test-log-get) '((once-cleanup))))))

(ert-deftest reactel-macro-memo-and-callback ()
  (let ((computes 0) cbs)
    (reactel-defcomponent reactel-test-mac-memo (&key x)
      (let ((v (reactel-use-memo* (x) (cl-incf computes) (* x x))))
        (push (reactel-use-callback* (x) (y) (+ x y)) cbs)
        (reactel-c-text (number-to-string v))))
    (with-root r (reactel-el 'reactel-test-mac-memo :x 3)
      (reactel-root-render r (reactel-el 'reactel-test-mac-memo :x 3))
      (should (= computes 1))
      (should (eq (car cbs) (cadr cbs)))
      (should (= (funcall (car cbs) 1) 4))
      (reactel-root-render r (reactel-el 'reactel-test-mac-memo :x 4))
      (should (= computes 2))
      (should (equal (txt r) "16"))
      (should (= (funcall (car cbs) 1) 5)))))

(ert-deftest reactel-let-hooks-destructures-sequentially ()
  (let (seen)
    (reactel-defcomponent reactel-test-lh ()
      (reactel-let-hooks (((n set-n) (reactel-use-state 2))
                          (ref (reactel-use-ref n))
                          (double (reactel-use-memo* (n) (* 2 n)))
                          (_ (reactel-use-effect* (n) (setq seen (list n double)) nil)))
        (ignore set-n ref)
        (reactel-c-text (number-to-string double))))
    (with-root r (reactel-el 'reactel-test-lh)
      (should (equal (txt r) "4"))
      (should (equal seen '(2 4))))))

(ert-deftest reactel-ref-moving-between-host-elements ()
  (let ((ref (reactel-create-ref)) setter)
    (reactel-defcomponent reactel-test-mover ()
      (cl-destructuring-bind (sel set-sel) (reactel-use-state 5)
        (setq setter set-sel)
        (reactel-c-text (mapcar (lambda (i)
				  (reactel-c-text :key i :ref (and (= i sel) ref)
                                    (format "%d;" i)))
				(number-sequence 1 9)))))
    (with-root r (reactel-el 'reactel-test-mover)
      (cl-flet ((text-of-ref ()
		  (let ((reg (reactel-buffer-node-region (reactel-ref-current ref))))
		    (substring (reactel-root-text r) (1- (car reg)) (1- (cdr reg))))))
	(should (equal (text-of-ref) "5;"))
	(funcall setter 2) (reactel-flush)   ; new row before the old one
	(should (equal (text-of-ref) "2;"))
	(funcall setter 8) (reactel-flush)   ; new row after the old one
	(should (equal (text-of-ref) "8;"))))))

