;;; reactel-ex-markdown.el --- Reactel example: one component, two backends -*- lexical-binding: t -*-

;; M-x reactel-demo-markdown
;;
;; `reactel-ex-markdown-report' is an ordinary component that only returns
;; `reactel-c-*' elements, so it does not know how it is displayed.  Here it is
;; rendered by two backends:
;;
;;   - the buffer backend shows it live, inside an interactive app with a filter;
;;   - the Markdown backend turns the very same component into Markdown text,
;;     which the app copies to the kill ring or shows in its own buffer.
;;
;; `reactel-ex-markdown-text' is the non-interactive way to use it:
;;
;;   (reactel-ex-markdown-text)  ; => "# Sprint report\n\n**2 of 4 done** ..."

(require 'dash)
(require 'reactel)
(require 'reactel-c)
(require 'reactel-buffer)
(require 'reactel-markdown)

(defconst reactel-ex-markdown-tasks
  '((:id 1 :title "Design the backend protocol" :owner "ada" :status done :points 5)
    (:id 2 :title "Buffer backend" :owner "ada" :status done :points 8)
    (:id 3 :title "Markdown backend" :owner "grace" :status doing :points 3)
    (:id 4 :title "Document the protocol" :owner "grace" :status todo :points 2))
  "Sample data for the report.")

(reactel-defcomponent reactel-ex-markdown-report (&key title tasks)
  "A report on TASKS.  Pure: it only describes what to show."
  (-let* ((done (--count (eq (plist-get it :status) 'done) tasks))
          (points (-sum (--map (plist-get it :points) tasks))))
    (reactel-c-vstack
      (reactel-c-heading title)
      (reactel-c-hstack
	(reactel-c-text :face 'bold (format "%d of %d done" done (length tasks)))
	(reactel-c-text (format "(%d points)" points)))
      (if (null tasks)
          (reactel-c-text :face 'italic "No tasks match.")
	(reactel-c-vstack
          (reactel-c-heading :level 2 "Tasks")
          (reactel-c-table :align '(left left left right)
            (reactel-c-row "Task" "Owner" "Status" "Points")
            (--map (-let (((&plist :id id :title title :owner owner :status status :points points) it))
                     (reactel-c-row :key id title owner (symbol-name status) (number-to-string points)))
                   tasks))
          (reactel-c-heading :level 2 "Checklist")
          (reactel-c-list
            (--map (reactel-c-checkbox :key (plist-get it :id)
                     :checked (eq (plist-get it :status) 'done)
                     (plist-get it :title))
                   tasks))))
      (reactel-c-box :title "Note"
	"Generated by reactel; the same component renders in a buffer and as Markdown.")
      (reactel-c-link :url "https://github.com/d12frosted/vui.el" "Related project: vui.el"))))

(defun reactel-ex-markdown-text (&optional tasks)
  "Render the report for TASKS (default: the sample tasks) as Markdown."
  (reactel-markdown-render
   (reactel-el 'reactel-ex-markdown-report :title "Sprint report"
     :tasks (or tasks reactel-ex-markdown-tasks))))

(defun reactel-ex-markdown--show (markdown)
  "Show the text MARKDOWN in its own buffer."
  (with-current-buffer (get-buffer-create "*reactel-markdown*")
    (let ((inhibit-read-only t))
      (erase-buffer)
      (insert markdown)
      (if (fboundp 'markdown-mode) (markdown-mode) (text-mode))
      (goto-char (point-min)))
    (pop-to-buffer (current-buffer))))

(reactel-defcomponent reactel-ex-markdown-app (&key (tasks reactel-ex-markdown-tasks))
  "The report with a status filter, and buttons that export it as Markdown."
  (-let* (((filter set-filter) (reactel-use-state 'all))
          (visible (reactel-use-memo* (tasks filter)
                     (if (eq filter 'all)
                         tasks
                       (--filter (eq (plist-get it :status) filter) tasks))))
          ;; Another backend, driven from an event handler: the report is
          ;; rendered to a string only when asked for.
          (markdown (reactel-use-callback* (visible)  ()
                      (reactel-markdown-render
                       (reactel-el 'reactel-ex-markdown-report
                         :title "Sprint report" :tasks visible))))
          (copy (reactel-use-callback* (markdown) ()
                  (kill-new (funcall markdown))
                  (message "Markdown copied to the kill ring")))
          (show (reactel-use-callback* (markdown) ()
                  (reactel-ex-markdown--show (funcall markdown)))))
    (reactel-c-vstack :spacing 1
      (reactel-c-hstack
	(reactel-c-text "Show:")
	(reactel-c-select :options '(all todo doing done) :value filter :on-change set-filter))
      (reactel-el 'reactel-ex-markdown-report :title "Sprint report" :tasks visible)
      (reactel-c-hstack
	(reactel-c-button :on-click copy "Copy as Markdown")
	(reactel-c-button :on-click show "Show Markdown")))))

(defun reactel-demo-markdown ()
  "Show the Markdown example."
  (interactive)
  (reactel-show "*reactel-markdown-demo*" (reactel-el 'reactel-ex-markdown-app)))

(provide 'reactel-ex-markdown)
;;; reactel-ex-markdown.el ends here
